{
  "manifest_version": 3,
  "name": "AudioTube",
  "version": "0.1.0",
  "description": "Play YouTube as audio only, without downloading the video stream.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup/popup.html", "default_title": "AudioTube" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
